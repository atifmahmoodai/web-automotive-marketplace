# Copy to .env and fill in. Never commit .env.

# --- Database ---
POSTGRES_PASSWORD=change-me-to-a-long-random-string
# docker-compose builds DATABASE_URL from POSTGRES_PASSWORD. Outside Docker set it yourself:
# DATABASE_URL=postgres://market:PASSWORD@localhost:5432/market

# --- Web ---
# The public address of the site (https in production). Used for the sitemap and the CSRF origin check.
PUBLIC_URL=http://localhost:8080
# Behind nginx / Caddy / a cloud load balancer that terminates https:
TRUST_PROXY=false
# Secure cookies need https. Defaults to true when NODE_ENV=production.
COOKIE_SECURE=false
NODE_ENV=production
APP_PORT=8080

# --- Sessions ---
SESSION_TTL_HOURS=168
SESSION_IDLE_HOURS=12

LOG_LEVEL=info
# Requests per minute per signed-in session (per IP for visitors). Photos have their own, higher allowance.
RATE_LIMIT_PER_MIN=300
# Largest photo upload in bytes (the web app shrinks photos to about 1600 px before uploading).
MAX_PHOTO_BYTES=3000000
